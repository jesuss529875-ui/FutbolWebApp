Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Object oDashboard is a cWebView

    Set piMaxWidth to 1024
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16
    
        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 8
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"
    
            // --- BIENVENIDA ---
            Object oWelcomeTile is a cWebHtmlBox
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div Class="WebCon_Sizer"><div class="Tile_Title">Welcome</div><div Class="Tile_Subtitle">--</div></div>'
    
                Procedure OnLoad
                    Send UpdateHTML ('<div class="WebCon_Sizer">' + ;
                                       '<div class="Tile_Title">Welcome</div>' +;
                                       '<div class="Tile_Subtitle">' - htmlEncode(psUserName(ghoWebSessionManager)) - '</div>' +;
                                       '</div>')
                End_Procedure
            End_Object
    
            // --- TILE 1: LIGA ---
            Object oLigaTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile LightAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div Class="Tile_Title">Ligas</div><div Class="Tile_Subtitle">Gestión de Ligas</div></div>'
                
                WebRegisterPath ntNavigateForward oLigaSelect
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object
    
            // --- TILE 2: EQUIPO ---
            Object oEquipoTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Dark"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div Class="Tile_Title">Equipos</div><div Class="Tile_Subtitle">Gestión de Equipos</div></div>'
                
                WebRegisterPath ntNavigateForward oEquipoSelect
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object
    
            // --- TILE 3: ENTRENADOR ---
            Object oEntrenadorTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile DarkAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div Class="Tile_Title">Entrenadores</div><div Class="Tile_Subtitle">Gestión de Entrenadores</div></div>'
                
                WebRegisterPath ntNavigateForward oEntrenadorSelect
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // --- TILE 4: JUGADOR ---
            Object oJugadorTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div Class="Tile_Title">Jugadores</div><div Class="Tile_Subtitle">Gestión de Jugadores</div></div>'
                
                WebRegisterPath ntNavigateForward oJugadorSelect
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // --- TILE 5: POSICION ---
            Object oPosicionTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile LightAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div Class="Tile_Title">Posiciones</div><div Class="Tile_Subtitle">Gestión de Posiciones</div></div>'
                
                WebRegisterPath ntNavigateForward oPosicionSelect
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // --- TILE 6: JUGADOR POSICION ---
            Object oJugadorPosicionTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Dark"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div Class="Tile_Title">Jugador Posición</div><div Class="Tile_Subtitle">Asignaciones</div></div>'
                
                WebRegisterPath ntNavigateForward oJugadorPosicionSelect
                
                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

        End_Object
    End_Object

    Procedure OnBeforeShow
    End_Procedure

End_Object