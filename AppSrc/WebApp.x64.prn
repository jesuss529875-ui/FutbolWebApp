38534>>>    Procedure SetActionButtons
38537>>>        tWebNavigateData NavigateData
38537>>>        tWebNavigateData NavigateData
38537>>>        Boolean bHasRecord
38537>>>        Handle hoDD
38537>>>
38537>>>        Get Server to hoDD
38538>>>        Get GetNavigateData to NavigateData
38539>>>        Get HasRecord of hoDD to bHasRecord
38540>>>
38540>>>        // let's hide all buttons and then Show the ones we want
38540>>>        WebSet pbRender of oEditBtn to False
38541>>>        WebSet pbRender of oSaveBtn to False
38542>>>        WebSet pbRender of oCancelChangesBtn to False
38543>>>        WebSet pbRender of oDeleteBtn to False
38544>>>
38544>>>        If (NavigateData.bReadOnly) Begin
38546>>>            WebSet pbRender of oEditBtn to True
38547>>>        End
38547>>>>
38547>>>        Else Begin
38548>>>            WebSet pbRender of oSaveBtn to True
38549>>>            WebSet pbRender of oCancelChangesBtn to True
38550>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38551>>>        End
38551>>>>
38551>>>    End_Procedure
38552>>>
38552>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38555>>>        // Close after save
38555>>>        Send NavigateClose Self
38556>>>    End_Procedure
38557>>>
38557>>>    // this will close the view after a delete
38557>>>    Procedure OnViewDeleted Handle hoDDO
38560>>>        Send NavigateClose Self
38561>>>    End_Procedure
