38568>>>
38568>>>            Case (NavigateData.eNavigateType = nfFromParent)
38571>>>                // If from parent, this is a constrained drill down.
38571>>>                Case Break
38572>>>
38572>>>            Case (NavigateData.eNavigateType = nfFromChild)
38575>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38575>>>                Case Break
38576>>>
38576>>>            Case Else // must be nfUndefined
38576>>>
38576>>>        Case End
38576>>>
38576>>>        Send SetActionButtons
38577>>>
38577>>>    End_Procedure
